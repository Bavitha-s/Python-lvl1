'''
binary number to decimal number conversion: 

1. maintain a power variable it starts with 0 . 
2. start from the right end 
calculate the following 
number at right position * 2 ** power 

i is index of current element 

decimal = decimal + binary[i] * 2 ** power 



ex:
  

power = 2 
decimal = 0 
decimal = 1 

decimal = 1

decimal = 5

'''
binary = input("Binary: ")
power = 0 
decimal = 0 

for digit in binary[::-1]:
    decimal = decimal + int(digit) * 2 ** power 
    power += 1 

print(f"Decimal: {decimal}")
