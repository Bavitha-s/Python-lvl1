def subtract(start, end):
    if start == end:
        return start  
    else:
        return start - subtract(start + 1, end)


print(subtract(1, 5))

def product(start, end):
    if start == end:
        return start  
    else:
        
        return start * product(start + 1, end)


print(product(1, 5))


def add(start,end):
    if start == end:
        return start
    else:
        return start + add(start + 1, end)
        
print(add(1,3))


def divide(start, end):
    if start == end:
        return 1
    else:
        return start / end

print(divide(5, 10))
