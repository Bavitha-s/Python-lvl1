# penta numbers

number = int(input("Number: "))
penta_number = "" 
while number > 0: 
    # get the remainder 
    remainder = number % 5
    penta_number += str(remainder) # converting integer to string to add to the string tenary_number
    number = number // 5 # result is always an integer 
    
 # reversing it beacuse binary numbers go bottom to top
penta_number = penta_number[::-1]
print(f"Penta Number: {penta_number}")
    
